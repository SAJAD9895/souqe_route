# Firebase — LEGACY. Leads moved to Supabase (website_leads); nothing in src/
# reads these any more. Kept until the Firestore data is retired.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Supabase — registration leads, product catalog, admin login, Create Account.
# Two projects; the admin header's Database picker chooses between them.
# Test / Staging
VITE_SUPABASE_STAGING_URL=
VITE_SUPABASE_STAGING_ANON_KEY=
# Live / Production
VITE_SUPABASE_PROD_URL=
VITE_SUPABASE_PROD_ANON_KEY=

# Which project the PUBLIC registration form writes leads to: 'test' | 'live'.
# Optional — defaults to live in production builds and test under `npm run dev`.
VITE_LEADS_SUPABASE_ENV=

# LOCAL ONLY, never commit, never prefix with VITE_. Used by
# scripts/migrate-leads-to-supabase.mjs; pass it on the command line instead
# of storing it in .env.
# SUPABASE_SERVICE_ROLE_KEY=
